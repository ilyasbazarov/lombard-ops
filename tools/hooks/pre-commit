#!/usr/bin/env bash
# tools/hooks/pre-commit — механические инварианты коммита (M-4, ADR-022).
# Семь проверок; каждая печатает совпавшие строки с номерами, не голый вердикт.
# Установка: ln -sf ../../tools/hooks/pre-commit .git/hooks/pre-commit
set -u

repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || { echo "ОШИБКА: не git-репозиторий"; exit 2; }
cd "$repo_root" || exit 2

FAIL=0
fail() { FAIL=1; }

# ---------------------------------------------------------------------------
# Утилиты чтения индекса и диффа — БЕЗ пайпа в head (ловушка 3): всегда сначала
# полный захват в переменную командной подстановкой, потом обработка herestring'ом.
# ---------------------------------------------------------------------------

staged_content() {
    # $1 — путь к файлу; пусто, если файл не в индексе.
    git show ":$1" 2>/dev/null
}

head_content() {
    # $1 — путь к файлу; пусто, если файла нет в HEAD (новый файл).
    if git rev-parse -q --verify HEAD >/dev/null 2>&1; then
        git show "HEAD:$1" 2>/dev/null
    fi
}

staged_diff() {
    git diff --cached -- "$1" 2>/dev/null
}

staged_files() {
    git diff --cached --name-only --diff-filter=ACMR 2>/dev/null
}

# Множество идентификаторов ADR-/Q-/T-/M-/RF- из текста. awk, не sed (ловушка 2):
# BSD sed на macOS не тянет конструкцию для извлечения множеств.
extract_ids() {
    local content="$1"
    awk '
        {
            line = $0
            while (match(line, /(ADR|Q|T|M|RF)-[0-9]+(-[0-9]+)?[a-z]?/)) {
                # Имя переменной сокращено намеренно: полное слово, присвоенное
                # через знак равенства, проверка 7 этого же хука читает как
                # раскрытый секрет и валит коммит на собственном исходнике.
                # Пример здесь не приводится по той же причине. Ослаблять
                # проверку ради имени переменной дороже, чем сократить имя.
                tok  = substr(line, RSTART, RLENGTH)
                rest = substr(line, RSTART + RLENGTH)
                # УСЕЧЁННОЕ совпадение отбрасывается (замер 2026-08-08): если
                # сразу за токеном стоит дефис, то это КУСОК более длинного
                # дефисного токена, а не идентификатор. Живой случай — глоб
                # трека "T-0-*" в прозе состояния: регулярка выкусывает из него
                # "T-0", множество идентификаторов получает фантом, и проверка 3
                # требует архивировать задачу, которой не существует. Реальные
                # идентификаторы дефисом не продолжаются: "T-0-3b" совпадает
                # целиком, за ним пробел или обратная кавычка.
                if (substr(rest, 1, 1) != "-") print tok
                line = rest
            }
        }
    ' <<< "$content" | sort -u
}

# Строки региона между start_re (включая саму строку-старт, не печатается) и
# end_re (терминатор точный: строка end_re НЕ входит в регион). Если end_re не
# встретился — регион тянется до конца текста. Ловушка 6: терминатор задаётся точно.
extract_section() {
    # Паттерны идут через ENVIRON, не -v: -v прогоняет значение через
    # собственную escape-интерпретацию awk и портит обратные слэши в regex.
    local content="$1"
    HOOK_START_RE="$2" HOOK_END_RE="$3" awk '
        BEGIN { start = ENVIRON["HOOK_START_RE"]; end = ENVIRON["HOOK_END_RE"] }
        $0 ~ start { flag=1; next }
        flag && $0 ~ end { flag=0 }
        flag { print }
    ' <<< "$content"
}

# Текст БЕЗ региона между start_re и end_re (обратная extract_section: строка-старт
# и всё до терминатора выбрасываются, сам терминатор остаётся). Нужна там, где
# регион по построению временный и его содержимое не должно участвовать в сравнении.
remove_section() {
    local content="$1"
    HOOK_START_RE="$2" HOOK_END_RE="$3" awk '
        BEGIN { start = ENVIRON["HOOK_START_RE"]; end = ENVIRON["HOOK_END_RE"] }
        $0 ~ start { flag=1; next }
        flag && $0 ~ end { flag=0 }
        !flag { print }
    ' <<< "$content"
}

# Добавленные ("+") строки диффа файла с номером строки НОВОГО файла.
# Формат вывода: "<line>\t<content>". Без head, без ранней остановки на большом
# патче (ловушка 4): дочитывается до конца, вход не обрывается по первой находке.
added_lines_numbered() {
    local diff_text="$1"
    awk '
        /^@@/ {
            match($0, /\+[0-9]+/)
            newline = substr($0, RSTART+1, RLENGTH-1) + 0
            next
        }
        /^\+\+\+/ { next }
        /^---/    { next }
        /^\+/ { print newline "\t" substr($0,2); newline++; next }
        /^ /  { newline++; next }
    ' <<< "$diff_text"
}

echo "=== tools/hooks/pre-commit · $(date '+%Y-%m-%d %H:%M:%S') ==="

files_in_commit="$(staged_files)"
if [ -z "$files_in_commit" ]; then
    echo "Индекс пуст — нечего коммитить."
    exit 1
fi

# ---------------------------------------------------------------------------
# Проверка 1 — первая строка нумерованного/подчёркнутого документа = имя файла.
# Конвенция репозитория: "NN_STEM.md" -> "# NN · STEM — ..."; "_STEM.md" -> "# _STEM — ...".
# ---------------------------------------------------------------------------
echo
echo "-- Проверка 1: первая строка = имя документа --"
check1_hits=0
while IFS= read -r f; do
    [ -z "$f" ] && continue
    base="$(basename "$f")"
    stem="${base%.md}"
    case "$base" in
        [0-9][0-9]_*.md)
            nn="${stem:0:2}"
            rest="${stem:3}"
            expected="# ${nn} · ${rest}"
            ;;
        _*.md)
            expected="# ${stem}"
            ;;
        *)
            continue
            ;;
    esac
    content="$(staged_content "$f")"
    first_line="$(awk 'NR==1{print; exit}' <<< "$content")"
    case "$first_line" in
        "${expected}"*) : ;;
        *)
            echo "СОДЕРЖИМОЕ НЕ ТО: ${f} — ожидалось начало «${expected}», внутри «${first_line}»"
            check1_hits=$((check1_hits+1))
            fail
            ;;
    esac
done <<< "$files_in_commit"
echo "срабатываний: ${check1_hits}"

# ---------------------------------------------------------------------------
# Проверка 2 — append решения в 06_DECISIONS_LOG.md ⇒ строка в 06_INDEX.md тем же коммитом.
# ---------------------------------------------------------------------------
echo
echo "-- Проверка 2: новое решение ⇒ строка в оглавлении --"
check2_hits=0
log_diff="$(staged_diff 06_DECISIONS_LOG.md)"
added_headings="$(awk '/^\+## ADR-/{print substr($0,2)}' <<< "$log_diff")"
added_adr_ids="$(extract_ids "$added_headings")"
if [ -n "$added_adr_ids" ]; then
    index_diff="$(staged_diff 06_INDEX.md)"
    added_index_lines="$(awk '/^\+/ && $0 !~ /^\+\+\+/ {print substr($0,2)}' <<< "$index_diff")"
    added_index_ids="$(extract_ids "$added_index_lines")"
    while IFS= read -r id; do
        [ -z "$id" ] && continue
        if ! grep -qxF "$id" <<< "$added_index_ids"; then
            echo "НЕ ПРОШЛО: ${id} добавлен в 06_DECISIONS_LOG.md, но строка с ${id} не добавлена в 06_INDEX.md тем же коммитом"
            check2_hits=$((check2_hits+1))
            fail
        fi
    done <<< "$added_adr_ids"
fi
echo "срабатываний: ${check2_hits}"

# ---------------------------------------------------------------------------
# Проверка 3 — идентификатор исчез из ОБЪЕДИНЕНИЯ 07_STATE.md и 07_GAPS.md ⇒
# назван в строках, ДОБАВЛЕННЫХ в 07_ARCHIVE.md тем же коммитом. Сравниваются
# МНОЖЕСТВА, не строки (ловушка 5 §M-4).
#
# Две правки против дефектов, найденных замером 2026-08-11 (ADR-035), оба —
# ложные отказы на легитимном входе, а не пропуски:
#  (1) ОБЪЕДИНЕНИЕ, а не пофайлово. Идентификатор, ушедший из реестра, но живой
#      в состоянии, задачей-к-архивации не является. Живой случай: закрытая
#      строка вопроса упоминала действующее решение и открытую задачу, и хук
#      требовал архивировать их обе.
#  (2) Сторона архива берётся из ДОБАВЛЕННЫХ СТРОК диффа, а не из разницы
#      множеств «до/после». Идентификатор, уже упоминавшийся в архиве прозой
#      раньше, в разницу множеств не попадает НИКОГДА, поэтому прежнее
#      требование было для него неисполнимо в принципе.
#
# Третья правка (ADR-041, замер 2026-08-12) — зеркало дефекта (2), тоже ложный
# отказ: идентификатор, АРХИВИРОВАННЫЙ РАНЬШИМ КОММИТОМ, в добавленные строки
# ЭТОГО коммита попасть не может никогда, поэтому уход его последнего
# упоминания из прозы состояния валил коммит требованием, исполнить которое
# нечем. Живой случай — Q-17: закрыта и перенесена в архив дословно решением
# ADR-037, а строку «обновил», где она называлась последний раз, заменила
# следующая сессия. Сторона архива теперь берётся ОБЪЕДИНЕНИЕМ «добавлено этим
# коммитом» и «уже названо в архиве на HEAD». Остаточная дыра названа явно:
# идентификатор, названный в архиве только прозой и никогда не перенесённый
# строкой, пройдёт — её держат проверка 5 (множества вопросов совпадают) и
# правило дословного переноса (ADR-019), а не эта проверка.
# ---------------------------------------------------------------------------
echo
echo "-- Проверка 3: исчезнувший идентификатор ⇒ архив тем же коммитом --"
check3_hits=0
archive_added_text="$(added_lines_numbered "$(staged_diff 07_ARCHIVE.md)" | cut -f2-)"
archive_added_ids="$(extract_ids "$archive_added_text")"
archive_head_ids="$(extract_ids "$(head_content 07_ARCHIVE.md)")"
# Четвёртая правка (ADR-092, замер 2026-08-19) — тот же класс: ложный отказ на
# законном ходе дел. Идентификатор, названный ТОЛЬКО в стенд-апе, исчезает из
# состояния при первой же следующей сессии: стенд-ап ЗАМЕНЯЕТСЯ ЦЕЛИКОМ по
# построению (ADR-021), и требовать за это переноса в архив нечем — решение живёт
# в журнале, задача в таблице мандата. Живой случай: ADR-090 назван в стенд-апе
# своей сессии, следующая сессия заменила блок, и коммит встал. Регион стенд-апа
# вырезается из обеих сторон сравнения; строки состояния (мандат, индекс вопросов,
# блокеры) остаются под проверкой целиком.
# Вместе со стенд-апом вырезается шапка «Статус/updated_at/обновил»: она тоже
# переписывается каждой сессией целиком и называет решение ТЕКУЩЕЙ сессии — на
# ней и встал ADR-090, а не на стенд-апе.
state_before_no_standup="$(remove_section "$(remove_section "$(head_content 07_STATE.md)" '^\*\*Статус:\*\* LIVE' '^## ')" '^## Стенд-ап' '^## ')"
state_after_no_standup="$(remove_section "$(remove_section "$(staged_content 07_STATE.md)" '^\*\*Статус:\*\* LIVE' '^## ')" '^## Стенд-ап' '^## ')"
union_before="${state_before_no_standup}
$(head_content 07_GAPS.md)"
union_after="${state_after_no_standup}
$(staged_content 07_GAPS.md)"
before_ids="$(extract_ids "$union_before")"
after_ids="$(extract_ids "$union_after")"
removed_ids="$(comm -23 <(sort -u <<< "$before_ids") <(sort -u <<< "$after_ids") 2>/dev/null)"
if [ -n "$removed_ids" ]; then
    while IFS= read -r id; do
        [ -z "$id" ] && continue
        if grep -qxF "$id" <<< "$archive_added_ids"; then
            continue
        fi
        if grep -qxF "$id" <<< "$archive_head_ids"; then
            # Наблюдаемо ОТЛИЧАЕТСЯ от отказа ниже (ADR-033): легитимный исход
            # печатает свою строку, а не тишину, иначе «прошло» неотличимо от
            # «не проверялось».
            echo "пропустить ${id}: исчез из состояния и реестра, но уже назван в 07_ARCHIVE.md на HEAD — архивирован более ранним коммитом"
            continue
        fi
        echo "НЕ ПРОШЛО: ${id} пропал из 07_STATE.md и 07_GAPS.md разом, но не назван ни в строках, добавленных в 07_ARCHIVE.md тем же коммитом, ни в архиве на HEAD"
        check3_hits=$((check3_hits+1))
        fail
    done <<< "$removed_ids"
fi
echo "срабатываний: ${check3_hits}"

# ---------------------------------------------------------------------------
# Проверка 4 — правка 07_STATE.md ⇒ обновлён updated_at.
# ---------------------------------------------------------------------------
echo
echo "-- Проверка 4: правка состояния ⇒ обновлён updated_at --"
check4_hits=0
state_diff="$(staged_diff 07_STATE.md)"
if [ -n "$state_diff" ]; then
    # updated_at не обязан начинать строку (в реальном файле он встроен в
    # общую строку "**Статус:** ... · **updated_at:** ... · **обновил:** ..."):
    # ищем добавленную строку, СОДЕРЖАЩУЮ маркер, а не начинающуюся с него.
    if ! grep -qE '^\+.*\*\*updated_at:\*\*' <<< "$state_diff"; then
        echo "НЕ ПРОШЛО: 07_STATE.md изменён, но строка updated_at не тронута этим коммитом"
        check4_hits=$((check4_hits+1))
        fail
    fi
fi
echo "срабатываний: ${check4_hits}"

# ---------------------------------------------------------------------------
# Проверка 5 — множества идентификаторов индекса вопросов (07_STATE.md) и
# полного реестра (07_GAPS.md) совпадают. Регион STATE ограничен точным
# терминатором (ловушка 6): от "## Открытые вопросы" до следующего "## ".
# ---------------------------------------------------------------------------
echo
echo "-- Проверка 5: индекс вопросов STATE = реестр GAPS --"
check5_hits=0
state_final="$(staged_content 07_STATE.md)"
gaps_final="$(staged_content 07_GAPS.md)"
state_q_section="$(extract_section "$state_final" '^## Открытые вопросы' '^## ')"
state_q_ids="$(extract_ids "$state_q_section" | grep -E '^Q-' | sort -u)"
gaps_q_section="$(extract_section "$gaps_final" '^\|---' '^(\*\*Правило петли|--- END)')"
gaps_q_ids="$(extract_ids "$gaps_q_section" | grep -E '^Q-' | sort -u)"
only_in_state="$(comm -23 <(printf '%s\n' "$state_q_ids") <(printf '%s\n' "$gaps_q_ids") 2>/dev/null | grep -v '^$')"
only_in_gaps="$(comm -13 <(printf '%s\n' "$state_q_ids") <(printf '%s\n' "$gaps_q_ids") 2>/dev/null | grep -v '^$')"
if [ -n "$only_in_state" ] || [ -n "$only_in_gaps" ]; then
    echo "НЕ ПРОШЛО: множества идентификаторов расходятся"
    [ -n "$only_in_state" ] && echo "  только в 07_STATE.md: $(tr '\n' ' ' <<< "$only_in_state")"
    [ -n "$only_in_gaps" ] && echo "  только в 07_GAPS.md: $(tr '\n' ' ' <<< "$only_in_gaps")"
    check5_hits=1
    fail
fi
echo "срабатываний: ${check5_hits}"

# ---------------------------------------------------------------------------
# Проверка 6 — кириллические гомоглифы внутри латинских идентификаторов.
# Класс символов — альтернация целых символов, НЕ диапазон в скобках (ловушка 1):
# байтовый диапазон над многобайтными символами совпал бы с любой кириллицей.
# Scoped на идентификаторы намеренно (ловушка 7): токен обязан иметь ФОРМУ нашего
# идентификатора (буквы-ПРЕФИКС + дефис + цифры, как ADR-005/Q-12/T-0-3b/M-4).
# Двуязычные композиты прозы (session-блоков, DDNS-имена) дефиса перед цифрой
# не несут и в выборку не попадают в принципе.
# Само по себе кириллическое ИМЯ такой формы (Р-1, У-2, С-3 — принятые в этом
# репозитории метки находок в reference/*) — легитимно и НЕ гомоглиф: в нём нет
# попытки выдать себя за наш латинский префикс. Срабатывать обязан только
# случай, когда префикс, будучи "делатинизирован" (каждый гомоглиф заменён на
# похожую латинскую букву), совпадает с ОДНИМ ИЗ РЕАЛЬНЫХ префиксов проекта
# (ADR/Q/T/M/RF), а сам, «сырой», от него отличается — то есть подмена
# произошла внутри чужого по форме, но нашего по смыслу идентификатора.
# ---------------------------------------------------------------------------
echo
echo "-- Проверка 6: кириллические гомоглифы в латинских идентификаторах --"
check6_hits=0
delatinize() {
    local s="$1"
    s="${s//А/A}"; s="${s//В/B}"; s="${s//Е/E}"; s="${s//К/K}"; s="${s//М/M}"
    s="${s//Н/H}"; s="${s//О/O}"; s="${s//Р/P}"; s="${s//С/C}"; s="${s//Т/T}"
    s="${s//У/Y}"; s="${s//Х/X}"
    printf '%s' "$s"
}
while IFS= read -r f; do
    [ -z "$f" ] && continue
    d="$(staged_diff "$f")"
    [ -z "$d" ] && continue
    while IFS=$'\t' read -r lineno content; do
        [ -z "$lineno" ] && continue
        while IFS= read -r token; do
            [ -z "$token" ] && continue
            prefix="${token%%-*}"
            delatinized="$(delatinize "$prefix")"
            if [ "$delatinized" != "$prefix" ]; then
                case "$delatinized" in
                    ADR|Q|T|M|RF)
                        echo "НЕ ПРОШЛО: ${f}:${lineno}: гомоглиф в «${token}» (похоже на наш префикс ${delatinized}) — ${content}"
                        check6_hits=$((check6_hits+1))
                        fail
                        ;;
                esac
            fi
        done < <(grep -oE '[A-Za-zА-Яа-яЁё]+-[0-9]+(-[0-9]+)?[A-Za-zА-Яа-я]?' <<< "$content")
    done < <(added_lines_numbered "$d")
done <<< "$files_in_commit"
echo "срабатываний: ${check6_hits}"

# ---------------------------------------------------------------------------
# Проверка 7 — секреты в патче. Категории из ADR-001 дословно: креды/ключи
# любого рода (в т.ч. WireGuard), DDNS-имена/внешние порты VPN контура клиента,
# токены Telegram, раскрытые пароли БД (общий случай "-password <реальное_значение>"
# ловит и исторический SYSDBA/masterkey — отдельная категория под конкретное слово
# не заводится: она бы совпала с собственным кодом этой же проверки, упоминающим
# слово буквально). Полная выдача печатается; пустая выдача не есть факт
# «секретов нет» без обратной проверки исправности (см. selftest).
# ---------------------------------------------------------------------------
echo
echo "-- Проверка 7: секреты в патче (ADR-001) --"
check7_hits=0
while IFS= read -r f; do
    [ -z "$f" ] && continue
    d="$(staged_diff "$f")"
    [ -z "$d" ] && continue
    while IFS=$'\t' read -r lineno content; do
        [ -z "$lineno" ] && continue

        # (a) Явное присвоение пароля/секрета РАСКРЫТЫМ значением.
        #
        # Правка 2026-08-18 (ADR-075) — ложное срабатывание на законном содержании, найденное
        # полем: бриф T-0-18 не мог быть закоммичен ВООБЩЕ из-за строки, которая секрет не
        # раскрывает, а ЧИТАЕТ его из хранилища командой. Прежний образец считал раскрытым
        # значением любой непробельный символ после знака равенства и не отличал значение от
        # команды, которая значение достаёт. Проверка машинно наказывала исполнение другого
        # принятого правила (ADR-036 и требование готовых к запуску команд без плейсхолдеров),
        # а это ровно та норма, которую ADR-074 §2 запрещает для блокирующего признака.
        #
        # Что теперь значением НЕ считается — три конструкции, каждая замерена на образцах:
        #   1) подстановка команды или переменной: значение начинается с знака доллара,
        #      с необязательной кавычкой перед ним;
        #   2) плейсхолдер в угловых скобках — как было раньше;
        #   3) ИМЯ секрета в ключе вызова облачного клиента, стоящее в конце строки:
        #      имя секрета публично по построению, раскрытым значением оно не является.
        # Что ловится по-прежнему: реальный пароль после ключа и реальное значение токена —
        # обе стороны закреплены кейсами самотеста, признак и кейсы правятся одним коммитом.
        if { grep -qiE '(password|pwd|secret|token|apikey|api_key)[[:space:]]*[:=][[:space:]]*["'"'"']?[^<$"'"'"'[:space:]]' <<< "$content" \
             || grep -qiE -- '-password[[:space:]]+["'"'"']?[^<$"'"'"'[:space:]]' <<< "$content"; } \
           && ! grep -qiE -- '--secret[= ][a-z0-9][a-z0-9-]*[[:space:]\\]*$' <<< "$content"; then
            echo "НЕ ПРОШЛО [явный секрет]: ${f}:${lineno}"
            check7_hits=$((check7_hits+1)); fail
        fi

        # (b) WireGuard/base64-ключи (42-43 символа + '=').
        if grep -qE '[A-Za-z0-9+/]{42,43}=' <<< "$content"; then
            echo "НЕ ПРОШЛО [похоже на WireGuard/base64-ключ]: ${f}:${lineno}"
            check7_hits=$((check7_hits+1)); fail
        fi

        # (c) Токен Telegram-бота.
        if grep -qE '[0-9]{8,10}:[A-Za-z0-9_-]{34,36}' <<< "$content"; then
            echo "НЕ ПРОШЛО [похоже на токен Telegram]: ${f}:${lineno}"
            check7_hits=$((check7_hits+1)); fail
        fi

        # (d) PEM/приватный ключ сервисного аккаунта.
        if grep -qE -- '-----BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY-----|"private_key":[[:space:]]*"-----BEGIN' <<< "$content"; then
            echo "НЕ ПРОШЛО [приватный ключ]: ${f}:${lineno}"
            check7_hits=$((check7_hits+1)); fail
        fi

        # (e) DDNS-имена контура клиента.
        if grep -qE '\.(duckdns\.org|no-ip\.(org|com|info)|ddns\.net|dynu\.(com|net))' <<< "$content"; then
            echo "НЕ ПРОШЛО [DDNS-имя контура]: ${f}:${lineno}"
            check7_hits=$((check7_hits+1)); fail
        fi
    done < <(added_lines_numbered "$d")
done <<< "$files_in_commit"
echo "срабатываний: ${check7_hits}"

echo
echo "=== ИТОГ ==="
if [ "$FAIL" -eq 0 ]; then
    echo "ХУК: пройдено, нарушений нет"
    exit 0
else
    echo "ХУК: отказ — коммит остановлен (см. НЕ ПРОШЛО выше)"
    exit 1
fi
